# knitr and R markdown default cache directories
.lintr
*_cache/
/cache/
*.utf8.md
*.knit.md

# Session Data files
.RData
.RDataTmp

# Dynare leaves .log files and generated folders behind. Figures go to
# output/figures/.
dynare/*
!dynare/*.mod
!dynare/*.md

# Dynare and MATLAB build output, anywhere
+*/
*.log
*.asv
desktop.ini

# Chapter 6: keep the models, data, scripts and figures. Drop the working
# history and everything Dynare regenerates.
chapter6/Archive/
chapter6/*/archive/
chapter6/*/DSGE_uribe_yue_IRFmatch*/

# Python
__pycache__/
*.pyc